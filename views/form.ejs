<!DOCTYPE html>
<html>
<head>
    <title>New Message</title>
    <style>
        form {
  max-width: 400px;
  margin: 20px auto;
  display: flex;
  flex-direction: column;
}

input, textarea {
  margin-bottom: 10px;
  padding: 8px;
}

button {
  padding: 8px;
  cursor: pointer;
}

body{
    background-color: royalblue;
    margin:0px;
    display: flex;
    justify-content: center;
    align-items: center;
    height:100vh;
}
a{
    color:white;
}
legend{
    color:white;
    background-color: crimson;
    border-radius:20px;
    padding:10px;
    text-align: center;
    font-weight: 600;
}
fieldset{
    width:10%;
    background-color: orangered;
}
form button {
  width: 45%;
  padding: 10px;
  background-color: #4CAF50;
  color: white;
  border: none;
  border-radius: 5px;
  font-size: 14px;
  cursor: pointer;
  margin: 10px;
}
form button:hover {
  opacity: 0.8;
}
form button a {
  color: white;
  text-decoration: none;
  display: block;
  text-align: center;
}
form button:hover a {
  text-decoration: none;
}
span{
    display: flex;
}
    </style>
</head>
<body>
    <fieldset>
         <legend>Create New Message</legend>
    <form action="/new" method="POST">
        <label for="user">Your Name</label>
        <input type="text" name="user" id="user" required>

        <label for="text">Message</label>
        <textarea name="text" id="text" required></textarea>
        <span>
        <button><a href="/">Cancel</a></button><button type="submit">Send</button>
        </span>
    </form>
    </fieldset>
    

</body>
</html>
